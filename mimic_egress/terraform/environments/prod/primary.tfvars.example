# =============================================================================
# environments/prod/primary.tfvars.example  (af-south-1, Octopus environment PROD)
# -----------------------------------------------------------------------------
# DOCUMENTS THE ASK; IS NEVER APPLIED. In production the egress service is the
# bank's — this file exists so the values we would put in the R-10 ticket are
# written down in the same shape the mimic uses. What we would receive back is
# egress-handover.auto.tfvars, typed by hand.
# =============================================================================

project_name   = "sbsa-besu"
environment    = "prod"
deletion_group = "n/a-bank-owned"
owner          = "ledger-platform@example.com"
cost_center    = "CC-XXXX"

region = "af-south-1"
az_id  = "afs1-az1"

egress_vpc_cidr = "<the bank's egress VIP prefix — from the ticket reply>"

proxy_port     = 8080 # whatever the bank's proxy listens on — from the ticket reply
proxy_dns_zone = "<bank corporate DNS zone>"
proxy_hostname = "<bank proxy VIP hostname>"

octopus_instance  = "<the bank's Octopus Cloud instance label>"
runner_private_ip = "<the runner's pinned address in ledger afs1-az1 — we send this>"
