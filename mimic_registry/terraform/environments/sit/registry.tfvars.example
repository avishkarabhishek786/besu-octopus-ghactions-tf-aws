# =============================================================================
# mimic_registry — SIT example. COPY to registry.tfvars (gitignored, CD-10).
# =============================================================================

environment    = "sit"
deletion_group = "sbsa-registry-sit-001" # this grant is long-lived; the registry has no expiry
owner          = "ledger-platform"
cost_center    = "REPLACE-ME"
region         = "af-south-1" # MUST be the VPC's region (CD-28)

github_repository = "<owner>/<name>"
# main for push-triggered runs; add the branch you dispatch from while it is unmerged.
allowed_refs = ["refs/heads/main"]

ecr_prefix                = "mirror"
allow_create_repositories = true

# Repositories created after 2026-07-15: the token's sub is
# repo:<owner>@<owner-id>/<name>@<repo-id>:ref:<ref>. IDs from
# GET https://api.github.com/repos/<owner>/<name>  (.owner.id, .id).
# github_ids = { owner = "<owner-id>", repository = "<repo-id>" }

# Anything else the workflow's "Show the OIDC subject" step printed — exact, never a wildcard.
extra_subjects = []
