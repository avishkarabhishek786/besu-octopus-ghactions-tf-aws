# =============================================================================
# tenancy.tf — the namespace the cloud team allots us, as YAML.
# -----------------------------------------------------------------------------
# WHY MANIFESTS AND NOT THE KUBERNETES PROVIDER
#   Three reasons, in order of weight:
#
#   1. FIDELITY. The cloud team hands us a namespace; they do not Terraform one
#      into our state. Rendering the YAML they would apply keeps the boundary in
#      the right place and keeps this root's state free of Kubernetes objects.
#   2. The API endpoint is PRIVATE in the strict profile, so a `kubernetes`
#      provider here could not reach it from a laptop — the same constraint the
#      platform lives with, which is why its in-cluster layer runs from the
#      runner (D-34). A second root to hold four objects is ceremony.
#   3. `terraform destroy` against a cluster whose Kubernetes objects share its
#      state is the teardown-order problem the platform already solved by
#      splitting roots. Not worth re-creating in a fixture.
#
# Applied by scripts/apply-tenancy.sh FROM THE RUNNER.
#
# -----------------------------------------------------------------------------
# INDENTATION IS LOAD-BEARING HERE, AND IT BIT ONCE.
# -----------------------------------------------------------------------------
# The first version built the pod-security labels as a hand-indented heredoc and
# interpolated it mid-block. The result put `enforce` at four spaces and `audit`
# and `warn` at two — INVALID YAML that `kubectl apply` would have rejected with
# a parser error pointing at a fixture, not at the platform.
#
# The fix is the rule below, and it is worth keeping:
#   * every interpolated block is built with NO leading indentation;
#   * the TEMPLATE supplies the first line's indent literally, and `indent(n, …)`
#     supplies it for every subsequent line — which is exactly what `indent`
#     does, since it deliberately skips the first line.
# Found by parsing the rendered output with a YAML loader rather than reading it.
# =============================================================================

locals {
  # #27 — the Pod Security labels, at column 0. `psa_cluster_wide` reproduces
  # question K: the namespace carries NO label, so `kubectl get ns --show-labels`
  # is MISLEADING and only a bare-Pod server-side dry-run finds the truth (D-40).
  psa_label_block = local.psa_cluster_wide ? "# NO pod-security label: enforcement is cluster-wide (question K)" : join("\n", [
    "pod-security.kubernetes.io/enforce: ${local.psa_level}",
    "pod-security.kubernetes.io/audit: ${local.psa_level}",
    "pod-security.kubernetes.io/warn: ${local.psa_level}",
  ])

  # #32 — the Role that `edit` does not give us, at column 0.
  # Two separate locals, not a ternary around a heredoc: HCL cannot continue a
  # conditional expression after a heredoc's terminator.
  crd_role_yaml = <<-ROLE
    ---
    # #32 — granted in the strict profile. `edit` enumerates BUILT-IN kinds, so a
    # namespace-scoped AmazonEKSEditPolicy does NOT cover custom resources unless
    # the owning add-on ships a ClusterRole labelled aggregate-to-edit.
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: tenant-custom-resources
      namespace: ${var.namespace_ledger}
    rules:
      - apiGroups: ["elbv2.k8s.aws"]
        resources: ["targetgroupbindings"]
        verbs: ["get","list","watch","create","update","patch","delete"]
      - apiGroups: ["secrets-store.csi.x-k8s.io"]
        resources: ["secretproviderclasses"]
        verbs: ["get","list","watch","create","update","patch","delete"]
      - apiGroups: ["monitoring.coreos.com"]
        resources: ["podmonitors","prometheusrules"]
        verbs: ["get","list","watch","create","update","patch","delete"]
  ROLE

  crd_role_absent = join("\n", [
    "# #32 — NO Role for our four custom resource kinds. TargetGroupBinding,",
    "# SecretProviderClass, PodMonitor and PrometheusRule are all refused.",
    "# Loud (Forbidden), but it blocks a deployment — which is why #32 asks",
    "# for this explicitly rather than assuming `edit` covers it.",
  ])

  crd_role_block = local.crd_rbac ? local.crd_role_yaml : local.crd_role_absent

  tenancy_manifest = <<-YAML
    # =========================================================================
    # GENERATED by mimic_eks. Profile: ${var.profile}
    # -------------------------------------------------------------------------
    # What the cloud team would create when allotting a tenant a namespace.
    # Apply FROM THE RUNNER:  mimic_eks/scripts/apply-tenancy.sh
    #
    # In the "hostile" profile these objects are DELIBERATELY WRONG. If the
    # platform's preflights PASS against this file, the preflights are broken —
    # that is the finding, not a reason to fix the fixture.
    # =========================================================================
    ---
    apiVersion: v1
    kind: Namespace
    metadata:
      name: ${var.namespace_ledger}
      labels:
        ${indent(4, local.psa_label_block)}
    ---
    apiVersion: v1
    kind: Namespace
    metadata:
      name: ${var.namespace_app}
      labels:
        ${indent(4, local.psa_label_block)}
    ---
    # #27 — the quota. Here requests.cpu is ${local.quota_cpu}.
    # At 6 it admits THREE validators and refuses the fourth: QBFT's quorum is
    # 3 of 4, so the chain produces blocks and reports healthy with ZERO fault
    # tolerance, and the refusal is an event on the StatefulSet with no fourth
    # pod to notice. The most important fixture in this project (D-36).
    apiVersion: v1
    kind: ResourceQuota
    metadata:
      name: ledger-quota
      namespace: ${var.namespace_ledger}
    spec:
      hard:
        requests.cpu: "${local.quota_cpu}"
        requests.memory: "${local.quota_memory}"
        limits.cpu: "${local.quota_cpu}"
        limits.memory: "${local.quota_memory}"
        pods: "${var.quota_pods}"
        persistentvolumeclaims: "${var.quota_pvc}"
        requests.storage: "${var.quota_storage}"
    ---
    # #30 — volumeBindingMode: ${local.storage_binding}
    # Immediate provisions the volume BEFORE the pod is scheduled, pinning it to
    # whichever AZ the provisioner chose; with validators spread across three,
    # one can end up permanently Pending with its data in the wrong zone and the
    # message says only "no nodes available".
    apiVersion: storage.k8s.io/v1
    kind: StorageClass
    metadata:
      name: ${local.storage_class_name}
    provisioner: ebs.csi.aws.com
    volumeBindingMode: ${local.storage_binding}
    allowVolumeExpansion: ${local.storage_expand}
    parameters:
      type: gp3
      encrypted: "true"
    ${local.crd_role_block}
  YAML
}

resource "local_file" "tenancy" {
  # Outside terraform/ so `terraform destroy` does not remove the record of what
  # was handed over. Gitignored: in production this would carry real namespace
  # names and quotas (CD-10).
  filename        = "${path.module}/../manifests/tenancy.yaml"
  content         = local.tenancy_manifest
  file_permission = "0644"
}
