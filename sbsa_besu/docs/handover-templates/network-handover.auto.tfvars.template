# =============================================================================
# network-handover.auto.tfvars — the VPC, as built by the network owner
# -----------------------------------------------------------------------------
# Fill in every value marked <...> and return this file to the ledger platform
# team. Keep the variable names and the format exactly as they are.
#
# Rules:
#   * Every per-AZ map is keyed by AZ ID (afs1-az1, afs1-az2, afs1-az3), never
#     by AZ name. AZ names map to different physical zones in different accounts.
#   * Use the IDs of resources that exist now. The platform checks every value
#     against live AWS before it builds anything, and stops with a requirement
#     number if one is wrong.
#
# Build reference: "VPC and EKS Build Checklist" Part 1, and
# VPC_EKS_ARCHITECTURE.md §11.2 to §11.5.
# =============================================================================

# --- The VPC -----------------------------------------------------------------

# The region the VPC is in. Expected: af-south-1.
network_region = "<region>"

# Expected: ["afs1-az1", "afs1-az2", "afs1-az3"]. All three are needed.
az_ids = ["<az-id-1>", "<az-id-2>", "<az-id-3>"]

vpc_id             = "<vpc-...>"
vpc_cidr_primary   = "<e.g. 10.60.0.0/20>"
vpc_cidr_secondary = "<e.g. 100.64.0.0/16; null if none is attached>"

# The DHCP option set associated with the VPC (AmazonProvidedDNS).
dhcp_options_id = "<dopt-...>"

# --- Subnet IDs, one per AZ per role (15 in total) -----------------------------

ledger_subnet_ids = {
  "afs1-az1" = "<subnet-...>"
  "afs1-az2" = "<subnet-...>"
  "afs1-az3" = "<subnet-...>"
}

app_subnet_ids = {
  "afs1-az1" = "<subnet-...>"
  "afs1-az2" = "<subnet-...>"
  "afs1-az3" = "<subnet-...>"
}

# Internal load balancer subnets. These carry the internal-elb tag.
lb_subnet_ids = {
  "afs1-az1" = "<subnet-...>"
  "afs1-az2" = "<subnet-...>"
  "afs1-az3" = "<subnet-...>"
}

# Interface endpoint subnets. Must be different subnets from the lb ones.
endpoint_subnet_ids = {
  "afs1-az1" = "<subnet-...>"
  "afs1-az2" = "<subnet-...>"
  "afs1-az3" = "<subnet-...>"
}

data_subnet_ids = {
  "afs1-az1" = "<subnet-...>"
  "afs1-az2" = "<subnet-...>"
  "afs1-az3" = "<subnet-...>"
}

# --- Subnet CIDRs, same layout --------------------------------------------------

subnet_cidrs_by_role = {
  ledger = {
    "afs1-az1" = "<cidr>"
    "afs1-az2" = "<cidr>"
    "afs1-az3" = "<cidr>"
  }
  app = {
    "afs1-az1" = "<cidr>"
    "afs1-az2" = "<cidr>"
    "afs1-az3" = "<cidr>"
  }
  lb = {
    "afs1-az1" = "<cidr>"
    "afs1-az2" = "<cidr>"
    "afs1-az3" = "<cidr>"
  }
  endpoint = {
    "afs1-az1" = "<cidr>"
    "afs1-az2" = "<cidr>"
    "afs1-az3" = "<cidr>"
  }
  data = {
    "afs1-az1" = "<cidr>"
    "afs1-az2" = "<cidr>"
    "afs1-az3" = "<cidr>"
  }
}

# --- Route tables, one per subnet ----------------------------------------------
# The data subnets' route tables are not needed. None of these tables may have
# a 0.0.0.0/0 route; the platform checks this.

ledger_route_table_ids = {
  "afs1-az1" = "<rtb-...>"
  "afs1-az2" = "<rtb-...>"
  "afs1-az3" = "<rtb-...>"
}

app_route_table_ids = {
  "afs1-az1" = "<rtb-...>"
  "afs1-az2" = "<rtb-...>"
  "afs1-az3" = "<rtb-...>"
}

lb_route_table_ids = {
  "afs1-az1" = "<rtb-...>"
  "afs1-az2" = "<rtb-...>"
  "afs1-az3" = "<rtb-...>"
}

endpoint_route_table_ids = {
  "afs1-az1" = "<rtb-...>"
  "afs1-az2" = "<rtb-...>"
  "afs1-az3" = "<rtb-...>"
}

# --- NACLs ---------------------------------------------------------------------
# The NACLs on the ledger subnets. If only security groups are used, write {}.

ledger_nacl_ids = {
  "afs1-az1" = "<acl-...>"
  "afs1-az2" = "<acl-...>"
  "afs1-az3" = "<acl-...>"
}

# --- VPC endpoints -------------------------------------------------------------

# true if the S3 and DynamoDB gateway endpoints already exist on the route
# tables above; false if the platform should create them.
gateway_endpoints_exist = "<true or false>"

# true if the interface endpoints (ssm, ecr.api, sts, kms and the rest) are
# already in this VPC and run by you; false if the platform should create them.
central_interface_endpoints = "<true or false>"
