# =============================================================================
# eks-handover.auto.tfvars — the EKS cluster and the ledger's place in it
# -----------------------------------------------------------------------------
# Fill in every value marked <...> and return this file to the ledger platform
# team. Keep the variable names and the format exactly as they are.
#
# Several values here are statements ("this is enforced", "this exists"). The
# platform checks each one against the live cluster before deploying, so a
# value that is not true will be found then, not later.
#
# Build reference: "VPC and EKS Build Checklist" Part 2, and
# VPC_EKS_ARCHITECTURE.md §5 and §11.6.
# =============================================================================

# --- The cluster -----------------------------------------------------------------

cluster_name   = "<cluster name>"
cluster_region = "<region, e.g. af-south-1>"

# aws eks describe-cluster --name <cluster> --query 'cluster.endpoint'
cluster_endpoint = "<https://....eks.amazonaws.com>"

# aws eks describe-cluster --name <cluster> --query 'cluster.certificateAuthority.data'
cluster_ca_data = "<base64 CA data>"

# The Kubernetes minor version, e.g. "1.36". The tested range is 1.33 to 1.36.
cluster_version = "<version>"

# --- Pod identity: fill in EITHER the two OIDC values (IRSA) OR set pod_identity
# to true. Not both, not neither.

oidc_provider_arn = "<arn:aws:iam::<account>:oidc-provider/oidc.eks....; empty if Pod Identity>"
oidc_issuer_url   = "<https://oidc.eks....; empty if Pod Identity>"

# true only if EKS Pod Identity is used instead of IRSA. It also needs the
# eks-auth interface endpoint in the VPC.
pod_identity = "<true or false>"

# --- The ledger's namespaces -------------------------------------------------------

# Expected: besu-ledger and besu-app.
namespace_ledger = "<namespace>"
namespace_app    = "<namespace>"

# The Pod Security level enforced on those namespaces: privileged, baseline or
# restricted. The ledger needs baseline. If Pod Security is set cluster-wide
# rather than by namespace label, give the cluster-wide level.
psa_level = "<baseline>"

# --- Storage -----------------------------------------------------------------------

# A gp3, encrypted StorageClass with WaitForFirstConsumer and
# allowVolumeExpansion: true.
storage_class_name = "<storage class name>"

# The KMS key that encrypts those volumes. Empty if the account's default EBS
# key is used.
storage_class_kms_key_arn = "<arn:aws:kms:...; or empty>"

# --- Add-ons the cluster provides ---------------------------------------------------
# true if installed and usable by the ledger's namespaces, false if not.

# AWS Load Balancer Controller, with TargetGroupBinding allowed in our namespace.
# The ledger cannot be reached without it.
cluster_provides_lbc = "<true or false>"

# Secrets Store CSI driver with the AWS provider.
cluster_provides_secrets_store_csi = "<true or false>"

# Prometheus Operator (PodMonitor and PrometheusRule).
cluster_provides_prometheus_operator = "<true or false>"

# Container logs shipped to a CloudWatch log group the platform team can read.
cluster_provides_log_shipping = "<true or false>"

# --- Nodes ---------------------------------------------------------------------------

# true if the ledger has its own tainted node group.
node_group_dedicated = "<true or false>"

# Only when node_group_dedicated is true; otherwise empty.
node_taint = "<e.g. dedicated=besu-ledger:NoSchedule>"
node_label = "<e.g. workload=besu-ledger>"

# The security group on the nodes. It must allow TCP 8545-8546 from the ledger's
# NLB security groups (the platform team sends you their IDs), unless Security
# Groups for Pods is used.
node_sg_id = "<sg-...>"

# The node IAM role. The ledger's ECR repositories will grant it pull access.
node_role_arn = "<arn:aws:iam::<account>:role/...>"

# true if that node role's own IAM policy includes ecr:GetAuthorizationToken
# (AmazonEC2ContainerRegistryReadOnly does). A repository policy cannot grant it.
node_role_ecr_auth_confirmed = "<true or false>"

# --- Where the ledger runs, keyed by AZ ID ---------------------------------------------

# The subnets the ledger's nodes are in.
cluster_node_subnet_ids = {
  "afs1-az1" = "<subnet-...>"
  "afs1-az2" = "<subnet-...>"
  "afs1-az3" = "<subnet-...>"
}

# The subnets the ledger's two internal NLBs may use.
cluster_lb_subnet_ids = {
  "afs1-az1" = "<subnet-...>"
  "afs1-az2" = "<subnet-...>"
  "afs1-az3" = "<subnet-...>"
}

# The subnet for the In-VPC EC2 Runner. It must contain the reserved runner IP
# from the egress hand-over.
cluster_runner_subnet_id = "<subnet-...>"

# --- Confirmations --------------------------------------------------------------------

# true if NetworkPolicy is enforced (VPC CNI with enableNetworkPolicy, or Calico
# or Cilium). Without enforcement, NetworkPolicy objects are accepted and do nothing.
network_policy_enforced = "<true or false>"

# true once the EKS access entry for the runner's IAM role exists, with
# AmazonEKSEditPolicy scoped to the two namespaces above, plus the Role for
# TargetGroupBinding, SecretProviderClass, PodMonitor and PrometheusRule.
# The platform team sends you the runner role ARN.
runner_access_entry_created = "<true or false>"
