  <diagram id="page-management" name="3 · Management view">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3t" value="&lt;b&gt;How the blockchain platform is built and released&lt;/b&gt;&lt;br&gt;Seven steps. One team builds the definition, an automated pipeline proves it, a controlled tool deploys it." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1000" height="48" as="geometry" />
        </mxCell>

        <mxCell id="p3h1" value="BUILD — automated, touches no environment" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5a7a4a;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p3s1" value="&lt;b&gt;1 · Define&lt;/b&gt;&lt;br&gt;&lt;br&gt;Our team writes and peer-reviews the definition of the whole platform, as code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="125" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3s2" value="&lt;b&gt;2 · Stock the private registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every third-party component is copied into the bank's private registry first. The environment itself never reaches the internet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="125" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3s3" value="&lt;b&gt;3 · Prove it and package it&lt;/b&gt;&lt;br&gt;&lt;br&gt;Automated checks run. Only if they pass is a versioned, immutable release created and recorded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="125" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p3n1" value="&lt;b&gt;The build pipeline can never deploy.&lt;/b&gt;&lt;br&gt;&lt;br&gt;It has internet access; the production environment deliberately does not. Keeping them apart is the control, not an inconvenience." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="125" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p3h2" value="DEPLOY — gated, approved, recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#9a6b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p3s4" value="&lt;b&gt;4 · Approve&lt;/b&gt;&lt;br&gt;&lt;br&gt;A named person signs off before anything reaches UAT or production." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="335" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3s5" value="&lt;b&gt;5 · Infrastructure layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Network, cluster, encryption keys, secrets and load balancers are built to the approved definition." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="335" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3s6" value="&lt;b&gt;6 · Blockchain layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Storage, the network's nodes, the block explorer and monitoring are deployed onto it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="335" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3s7" value="&lt;b&gt;7 · Validators, one at a time — then verify&lt;/b&gt;&lt;br&gt;&lt;br&gt;The block-signing nodes are changed individually, checking the ledger is still producing blocks between each one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="335" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p3h3" value="PROMOTION — the same release moves forward, unchanged" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p3sit" value="&lt;b&gt;SIT&lt;/b&gt;&lt;br&gt;integration testing&lt;br&gt;&lt;br&gt;deploys automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3uat" value="&lt;b&gt;UAT&lt;/b&gt;&lt;br&gt;business sign-off&lt;br&gt;&lt;br&gt;⛔ approval required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="555" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3prd" value="&lt;b&gt;PRODUCTION&lt;/b&gt;&lt;br&gt;the live ledger&lt;br&gt;&lt;br&gt;⛔ approval required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="740" y="555" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p3n2" value="&lt;b&gt;Who does what&lt;/b&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;br&gt;&lt;b&gt;Our team&lt;/b&gt; — defines the platform, cuts releases, runs the validator upgrades.&lt;br&gt;&lt;br&gt;&lt;b&gt;The cloud team&lt;/b&gt; — provides the build machines, the private registry, the network and the deployment tool.&lt;br&gt;&lt;br&gt;&lt;b&gt;The deployment tool&lt;/b&gt; — is the only thing that changes an environment, and it records every change.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="520" width="330" height="230" as="geometry" />
        </mxCell>

        <mxCell id="p3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3s1" target="p3s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3s2" target="p3s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e3" value="a release is ready — nothing is deployed yet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3s3" target="p3s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3s4" target="p3s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3s5" target="p3s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3s6" target="p3s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e7" value="steps 4 – 7 repeat, unchanged, in each environment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="p3s4" target="p3sit">
          <mxGeometry relative="1" as="geometry" />
