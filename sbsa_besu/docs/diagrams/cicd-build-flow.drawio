          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2pull" value="the cluster pulls every image and chart from ECR, through the ecr.api / ecr.dkr interface endpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;strokeColor=#9673a6;" edge="1" parent="1" source="p2a1" target="p2hB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2leg" value="&lt;b&gt;Legend&lt;/b&gt;  &lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;nbsp;infrastructure layer&amp;nbsp;&lt;/span&gt;  &lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;nbsp;blockchain layer&amp;nbsp;&lt;/span&gt;  &lt;span style=&quot;background:#f8cecc&quot;&gt;&amp;nbsp;safety-critical&amp;nbsp;&lt;/span&gt;  &lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;nbsp;registry&amp;nbsp;&lt;/span&gt;  &lt;span style=&quot;background:#ffe6cc&quot;&gt;&amp;nbsp;Octopus&amp;nbsp;&lt;/span&gt;   — — — dashed = image / chart pull (data flow)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="1148" width="1300" height="26" as="geometry" />
        </mxCell>
