          <mxGeometry x="275" y="95" width="1190" height="1150" as="geometry" />
        </mxCell>

        <!-- shared egress (cloud team) -->
        <mxCell id="egressbox" value="Shared egress (cloud team) — reached over the Transit Gateway by a specific-prefix route from the runner subnet only" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5AA9DA;dashed=1;dashPattern=8 4;fontColor=#5AA9DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="290" y="130" width="560" height="90" as="geometry" />
