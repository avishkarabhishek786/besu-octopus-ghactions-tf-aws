# =============================================================================
# modules/secrets/variables.tf
# -----------------------------------------------------------------------------
# Inputs for the secrets module. This module is the SINGLE place that writes to
# AWS Secrets Manager. It stores:
#   * CA material handed in from modules/pki (cert -> pod-readable; key -> not),
#   * Terraform-generated passwords/JWT secret (keystore, truststore, RPC auth),
#   * the secret CONTAINERS for Besu node (validator + bootnode) keys, whose
#     VALUES come from provided keys or from stage-3 genesis tooling (secp256k1
#     keys cannot be generated by the tls provider — see main.tf header).
# It also installs the in-cluster Secrets Store CSI AWS provider DaemonSet.
# =============================================================================

variable "name_prefix" {
  description = "Prefix for AWS resource names (region-role-aware root prefix)."
  type        = string
}

# --- CA material from modules/pki --------------------------------------------
variable "ca_mode" {
  description = "CA backend ('' = self-managed, 'aws' = AWS Private CA). Used to decide whether the CA private key secret is created — gated on this KNOWN input rather than the key value (which is apply-time only)."
  type        = string
  default     = ""
}

variable "ca_cert_pem" {
  description = "PEM-encoded CA certificate (public) from modules/pki. Stored under besu-node-ca-cert so pods (truststore) and operators can read it."
  type        = string
}

variable "ca_private_key_pem" {
  description = "PEM-encoded CA PRIVATE key from modules/pki, or null when ca_mode='aws' (key stays in acm-pca). When non-null, stored under besu-ca-private-key (OUTSIDE the besu-node-* IRSA scope, so Besu pods cannot read it)."
  type        = string
  default     = null
  sensitive   = true
}

# --- Node key inventory (containers) -----------------------------------------
variable "validator_count" {
  description = "Number of validator node-key secret containers to create (besu-node-validator-1..N)."
  type        = number
  default     = 4
}

variable "bootnode_count" {
  description = "Number of bootnode node-key secret containers to create (besu-node-bootnode-1..M)."
  type        = number
  default     = 2
}

variable "rpc_node_count" {
  description = "Number of RPC node-key secret containers to create (besu-node-rpc-1..K). RPC nodes need node identities too, since node-local permissioning is deny-by-default."
  type        = number
  default     = 2
}

variable "app_rpc_node_count" {
  description = "Stage 8: number of app-rpc node-key secret containers (besu-node-app-rpc-1..J). The app-facing RPC pool inside the chain cluster. 0 = app layer not deployed."
  type        = number
  default     = 0
}

variable "explorer_rpc_node_count" {
  description = "Stage 9: number of explorer-rpc node-key secret containers (besu-node-explorer-rpc-1..E). The Blockscout read-only RPC pool inside the chain cluster. 0 = explorer not deployed."
  type        = number
  default     = 0
}

variable "use_provided_validator_keys" {
  description = "When true, validator secret VALUES are written from validator_private_keys (which must have at least validator_count entries). When false, containers are created empty and stage-3 genesis tooling writes the values."
  type        = bool
  default     = false
}

variable "validator_private_keys" {
  description = "Provided validator private keys (used only when use_provided_validator_keys = true). Supply via a gitignored secrets tfvars; never commit."
  type        = list(string)
  default     = []
  sensitive   = true
}

# --- Secrets Manager behaviour -----------------------------------------------
variable "recovery_window_days" {
  description = "Secrets Manager recovery window on delete. PROD: 7-30 (recoverable). NON-PROD: 0 (force-delete immediately so test teardown leaves nothing billing and a re-apply does not collide with a secret 'scheduled for deletion')."
  type        = number
  default     = 30
}

variable "node_key_cmk_arn" {
  description = "C12: customer-managed KMS CMK ARN to encrypt the node-key secrets (validator/bootnode/rpc/app-rpc/explorer-rpc) and the self-managed CA private key at rest. Empty = the AWS-managed aws/secretsmanager key. When set, the pod/genesis IRSA roles must also carry kms:Decrypt (wired in modules/iam)."
  type        = string
  default     = ""
}

# --- In-cluster wiring -------------------------------------------------------
variable "deploy_in_cluster_resources" {
  description = "When true, install the Secrets Store CSI AWS provider DaemonSet via Helm (talks to the Kubernetes API — only reachable from inside the VPC). False on laptop applies against the private endpoint. The Secrets Manager (AWS-layer) resources are created regardless."
  type        = bool
  default     = true
}

variable "aws_provider_chart_version" {
  description = "Pinned Helm chart version of secrets-store-csi-driver-provider-aws (the ASCP). Verified current stable. v3 bundles the generic driver, which we disable since stage 1 installs it separately."
  type        = string
  default     = "3.1.1"
}

variable "tags" {
  description = "Additional tags merged onto AWS resources in this module."
  type        = map(string)
  default     = {}
}

# PORTING item 4 — the upstream chart, and the images it carries, from the
# private registry. Both come from the root (local.chart_repository /
# local.chart_images); "" and {} keep the upstream https repository and the
# chart's own image defaults, which only work where there is egress.
variable "chart_repository" {
  description = "OCI repository holding the mirrored upstream charts (oci://<registry>/<path>). Empty = the chart's upstream https repository."
  type        = string
  default     = ""
}

variable "chart_images" {
  description = "Chart-carried images keyed as in mirror.manifest: registry, repository (path inside the registry) and tag. A missing key leaves that chart's image default."
  type = map(object({
    registry   = string
    repository = string
    tag        = string
  }))
  default = {}
}
