# =============================================================================
# modules/pki/variables.tf
# -----------------------------------------------------------------------------
# Inputs for the PKI (certificate authority) bootstrap. This module establishes
# the ROOT of trust for the mTLS plane that protects JSON-RPC (the SWIFT-facing
# endpoint, wired up in stage 4). It produces a CA whose key signs:
#   * the RPC server certificate (our endpoint identity), and
#   * SWIFT/participant client certificates (issued via CSR-signing in stage 4).
# The CA material is handed to modules/secrets, which is the ONLY place that
# writes it to AWS Secrets Manager — this module never touches Secrets Manager
# so the "generate" and "store" concerns stay cleanly separated.
# =============================================================================

variable "name_prefix" {
  description = "Prefix for PKI resource names (matches the region-role-aware root prefix)."
  type        = string
}

variable "ca_mode" {
  description = <<-EOT
    Which certificate authority backs mTLS:
      ""    = SELF-MANAGED CA (default): an RSA-4096 CA key + self-signed CA cert
              generated by the tls provider. Near-zero cost. This is what the
              non-prod test and the documented default use.
      "aws" = AWS PRIVATE CA (acm-pca): a managed ROOT CA. ~USD 400/month, so it
              is GATED behind this flag and never created in non-prod.
    Mirrors the settled decision in CLAUDE.md (self-managed default, AWS PCA
    optional).
  EOT
  type        = string
  default     = ""

  validation {
    condition     = var.ca_mode == "" || var.ca_mode == "aws"
    error_message = "ca_mode must be empty (self-managed) or 'aws' (AWS Private CA)."
  }
}

variable "ca_common_name" {
  description = "Subject common name (CN) for the CA certificate (e.g. \"Besu RPC mTLS Root CA\")."
  type        = string
  default     = "Besu RPC mTLS Root CA"
}

variable "ca_organization" {
  description = "Subject organization (O) for the CA certificate."
  type        = string
  default     = "Besu AWS Network"
}

variable "ca_validity_days" {
  description = "Validity period of the self-managed CA certificate, in days. Default 3650 (10 years) — a long-lived root, as is conventional for a private CA whose key is the anchor of the whole mTLS trust chain."
  type        = number
  default     = 3650
}

variable "tags" {
  description = "Additional tags merged onto AWS resources created by this module (the tls-provider resources are local and untagged)."
  type        = map(string)
  default     = {}
}
