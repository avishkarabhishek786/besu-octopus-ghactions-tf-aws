# =============================================================================
# environments/sit/primary.tfvars  (af-south-1, Octopus environment SIT)
# -----------------------------------------------------------------------------
# Copy to primary.tfvars (gitignored) and fill in. Topology is IDENTICAL to
# prod; only the region, AZ IDs and rates differ.
# =============================================================================

project_name   = "sbsa-besu"
environment    = "sit"
deletion_group = "sbsa-net-sit-2026-09-17" # UNIQUE per deployment
owner          = "you@example.com"
cost_center    = "CC-XXXX"

region = "af-south-1" # opt-in region; VERIFIED ENABLED 2026-09-04 by
#                        scripts/preflight/verify-region.sh (7 passed, 0 failed)
# AZ IDs, not names. Confirm yours: aws ec2 describe-availability-zones \
#   --region af-south-1 --query 'AvailabilityZones[].[ZoneName,ZoneId]' --output table
az_ids = ["afs1-az1", "afs1-az2", "afs1-az3"]

vpc_cidr              = "10.60.0.0/20"
enable_secondary_cidr = true
secondary_cidr        = "100.64.0.0/16" # associated, deliberately UNUSED (#17)

ledger_cluster_name = "sbsa-besu-ledger"
app_cluster_name    = "sbsa-besu-app"

# #10 — exercise BOTH values across two runs; the cloud team's real answer is
# not yet known and the platform must work either way.
gateway_endpoints_created_here = true

# Q-2 — leave false: the platform owns its interface endpoints (D-11).
simulate_central_endpoints = false

enable_flow_logs        = true
flow_log_retention_days = 1 # SHORT: the only billable resource in this project

# #34 F-8 — the egress proxy's prefix (mimic_egress's egress_vpc_cidr). EMPTY OMITS the
# runner -> proxy rule and its return: under nacl_mode = "flows" the Octopus Tentacle
# on the In-VPC EC2 Runner then cannot poll (B40). Set it for any run with a runner.
egress_proxy_cidr = "10.61.0.0/24"

# #34 / R-10 (B43) — EXPLICIT reservation on the runner's pinned /32 (mimic_egress
# runner_private_ip), so the VPC CNI's warm pool cannot take it. Without it EC2 can
# refuse the runner with InvalidIPAddress.InUse.
pinned_ip_reservations = { "afs1-az1" = "10.60.0.250" }
